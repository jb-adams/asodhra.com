---
// The home page. Its copy comes from docs/HOMEPAGE.md; keep the two in step.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SectionArt from '../components/SectionArt.astro';
import { getNovels, romanNumeral } from '../lib/novels';

const novels = await getNovels();
const [firstNovel] = novels;

/*
 * Section art. To add an image, put it in src/assets/home/, import it at the
 * top of this file and set it here. `light` is optional: without it, light
 * mode shows the dark image. Landscape images at least 2400px wide work best.
 */
type Art = { dark?: ImageMetadata; light?: ImageMetadata; position?: string };
const art: Record<'hero' | 'genres' | 'begin', Art> = {
	hero: {},
	genres: {},
	begin: {},
};

// What sets Asodhra apart. Each can take an `image` (and `lightImage`) later.
const hooks: { title: string; text: string; image?: ImageMetadata; lightImage?: ImageMetadata }[] = [
	{
		title: 'Jeweled Cities & Ancient Ruins',
		text: 'From the opulent capital of Sonanarth to vine-choked temples and desert monasteries, Asodhra draws on the splendor of the Silk Roads, Southeast Asia, and the Caribbean.',
	},
	{
		title: 'Rotten Gods',
		text: 'Eldritch horrors lurk in the underworld. They imprison their followers within beautiful dreams, then feast upon their souls.',
	},
	{
		title: 'The Sorkarian Order',
		text: 'In cerulean jackets embroidered with gold, the assassin priests of the Sorkarian Order wage a secret war against the rotten gods.',
	},
];

const enjoy = [
	'Fallible protagonists who struggle, make desperate decisions, and wrestle with their inner demons',
	'Nuanced morality where the line between good and evil is rarely clear',
	'Tragic victories and flat-out defeats',
	'Mysterious magic systems with unclear yet consistent properties',
];

const prefer = [
	'Likeable, wish-fulfillment protagonists you can always root for',
	'Clear-cut morality with unambiguously good and evil factions',
	'Triumphant endings',
	'Hard magic systems with thoroughly explained rules',
];
---

<StarlightPage
	frontmatter={{
		title: 'Asodhra',
		description:
			'Asodhra, the world of the Asodhran Sagas by Jeremy Bruce Adams: dark epic fantasy meets cosmic and eldritch horror.',
		template: 'splash',
		pagefind: false,
		hero: {
			title: '<span class="asodhra-welcome">Welcome to</span> Asodhra',
			tagline: 'Beware the gods who promise paradise.',
		},
	}}
>
	<div class="asodhra-home not-content">
		<SectionArt class="asodhra-hero-art" {...art.hero} />
		<div class="asodhra-scroll-cue" aria-hidden="true"></div>

		<section class="asodhra-band asodhra-reveal">
			<SectionArt {...art.genres} />
			<h2 class="asodhra-genres">
				Dark Epic Fantasy <span class="asodhra-genres-meets">meets</span> Cosmic &amp; Eldritch Horror
			</h2>
			<ul class="asodhra-tags">
				<li>Corruptible Heroes</li>
				<li>Capricious Deities</li>
				<li>Murky Morality</li>
			</ul>
		</section>

		<section class="asodhra-prose asodhra-reveal">
			<p class="asodhra-lede">
				Asodhra is a dark fantasy world teeming with forbidden knowledge and sinister entities, created by author
				Jeremy Bruce Adams and published under his self-publishing imprint, Brass Jungle.
			</p>
		</section>

		<section class="asodhra-hooks" aria-label="What awaits in Asodhra">
			{
				hooks.map((hook) => (
					<article class="asodhra-hook asodhra-reveal">
						{hook.image && (
							<SectionArt class="asodhra-hook-art" dark={hook.image} light={hook.lightImage} />
						)}
						<h3>{hook.title}</h3>
						<p>{hook.text}</p>
					</article>
				))
			}
		</section>

		<section class="asodhra-prose asodhra-reveal">
			<p>
				You are hereby invited to explore these archives at your leisure, and sate your dark curiosity with the
				stories and lore contained within.
			</p>
			<hr class="asodhra-stars" />
		</section>

		<section class="asodhra-fit asodhra-reveal" aria-labelledby="asodhra-fit-intro">
			<p id="asodhra-fit-intro" class="asodhra-fit-intro">
				But if this is your first time here, be aware that the Asodhran Sagas are not for everyone.
			</p>
			<div class="asodhra-fit-columns">
				<div class="asodhra-fit-column asodhra-fit-yes">
					<p>If you enjoy:</p>
					<ul>{enjoy.map((item) => <li>{item}</li>)}</ul>
					<p class="asodhra-fit-verdict">Then you might be in the right place.</p>
				</div>
				<div class="asodhra-fit-column asodhra-fit-no">
					<p>On the other hand, if you prefer:</p>
					<ul>{prefer.map((item) => <li>{item}</li>)}</ul>
					<p class="asodhra-fit-verdict">
						Then Asodhra probably won't offer you the experience you're looking for.
					</p>
				</div>
			</div>
			<hr class="asodhra-stars" />
		</section>

		<section id="books" class="asodhra-begin">
			<SectionArt {...art.begin} />
			{
				firstNovel && (
					<p class="asodhra-begin-lede asodhra-reveal">
						If you are ready to begin, continue on to <em>{firstNovel.data.title}</em>, the first novel of{' '}
						<em>The Dream Stalker Trilogy</em>.
					</p>
				)
			}
			<h2 class="asodhra-flourish asodhra-reveal">The Dream Stalker Trilogy</h2>
			<p class="asodhra-eyebrow">by Jeremy Bruce Adams</p>
			<div class="asodhra-book-grid">
				{
					novels.map((novel, i) => (
						<a class="asodhra-book asodhra-reveal" href={`/novels/${novel.id}/`}>
							{novel.data.cover ? (
								<Image
									class="asodhra-book-cover"
									src={novel.data.cover}
									alt={novel.data.title}
									widths={[256, 512]}
									sizes="16rem"
								/>
							) : (
								<span class="asodhra-book-cover asodhra-cover-placeholder">
									<span class="asodhra-book-title">{novel.data.title}</span>
								</span>
							)}
							<span class="asodhra-book-number">
								Book {romanNumeral(novel.data.book)}
								{i === 0 && ' · Begin here'}
							</span>
							<span class="asodhra-book-description">{novel.data.description}</span>
						</a>
					))
				}
			</div>
			<div class="asodhra-actions">
				{
					firstNovel && (
						<LinkButton href={`/novels/${firstNovel.id}/`} icon="right-arrow">
							Start reading {firstNovel.data.title}
						</LinkButton>
					)
				}
				<LinkButton href="/lore/" variant="secondary">
					Explore the lore
				</LinkButton>
			</div>
		</section>
	</div>
</StarlightPage>
