---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { chapterSlug, getChapters } from '../../../lib/novels';

export const getStaticPaths = (async () => {
	const chapters = await getCollection('chapters');
	return Promise.all(
		chapters.map(async (chapter) => {
			// Astro only logs broken references, so fail the build here instead
			// of silently dropping the chapter.
			const novel = await getEntry(chapter.data.novel);
			if (!novel) {
				throw new Error(`Chapter "${chapter.id}" references novel "${chapter.data.novel.id}", which does not exist.`);
			}
			const siblings = await getChapters(novel.id);
			const i = siblings.findIndex((c) => c.id === chapter.id);
			return {
				params: { novel: novel.id, chapter: chapterSlug(chapter.id) },
				props: { novel, chapter, prev: siblings[i - 1], next: siblings[i + 1] },
			};
		}),
	);
}) satisfies GetStaticPaths;

const { novel, chapter, prev, next } = Astro.props;
const { Content } = await render(chapter);
const novelUrl = `/novels/${novel.id}/`;
---

<StarlightPage
	frontmatter={{
		title: chapter.data.title,
		template: 'splash',
		prev: prev ? { link: `${novelUrl}${chapterSlug(prev.id)}/`, label: prev.data.title } : false,
		next: next ? { link: `${novelUrl}${chapterSlug(next.id)}/`, label: next.data.title } : false,
	}}
>
	<div class="asodhra-reading" data-palette={novel.data.palette}>
		<p class="asodhra-eyebrow"><a href={novelUrl}>{novel.data.title}</a> · Chapter {chapter.data.chapter}</p>
		<div class="asodhra-chapter">
			<Content />
		</div>
	</div>
</StarlightPage>
