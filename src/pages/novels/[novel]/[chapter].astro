---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import ReadingLayout from '../../../layouts/ReadingLayout.astro';
import { chapterSlug, getChapters } from '../../../lib/novels';

export const getStaticPaths = (async () => {
	const chapters = await getCollection('chapters');
	return Promise.all(
		chapters.map(async (chapter) => {
			// Astro only logs broken references, so fail the build here instead
			// of silently dropping the chapter.
			const novel = await getEntry(chapter.data.novel);
			if (!novel) {
				throw new Error(`Chapter "${chapter.id}" references novel "${chapter.data.novel.id}", which does not exist.`);
			}
			const siblings = await getChapters(novel.id);
			const i = siblings.findIndex((c) => c.id === chapter.id);
			return {
				params: { novel: novel.id, chapter: chapterSlug(chapter.id) },
				props: { novel, chapter, prev: siblings[i - 1], next: siblings[i + 1] },
			};
		}),
	);
}) satisfies GetStaticPaths;

const { novel, chapter, prev, next } = Astro.props;
const { Content } = await render(chapter);
const novelUrl = `/novels/${novel.id}/`;
---

<ReadingLayout title={`${chapter.data.title} · ${novel.data.title}`}>
	<p class="muted"><a href={novelUrl}>{novel.data.title}</a> · Chapter {chapter.data.chapter}</p>
	<article data-pagefind-body>
		<h1>{chapter.data.title}</h1>
		<Content />
	</article>

	<nav class="chapter-nav">
		{prev ? <a href={`${novelUrl}${chapterSlug(prev.id)}/`}>← {prev.data.title}</a> : <span />}
		{next ? <a href={`${novelUrl}${chapterSlug(next.id)}/`}>{next.data.title} →</a> : <a href={novelUrl}>Contents</a>}
	</nav>
</ReadingLayout>

<style>
	.chapter-nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-family: system-ui, sans-serif;
		font-size: 1rem;
	}
</style>
