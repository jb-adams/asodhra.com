---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ReadingLayout from '../../../layouts/ReadingLayout.astro';
import { chapterSlug, getChapters, getNovels } from '../../../lib/novels';

export const getStaticPaths = (async () => {
	const novels = await getNovels();
	return novels.map((novel) => ({ params: { novel: novel.id }, props: { novel } }));
}) satisfies GetStaticPaths;

const { novel } = Astro.props;
const chapters = await getChapters(novel.id);
const { Content } = await render(novel);
---

<ReadingLayout title={novel.data.title} description={novel.data.description}>
	<article data-pagefind-body>
		<h1>{novel.data.title}</h1>
		<Content />
	</article>

	<h2>Chapters</h2>
	<ol>
		{
			chapters.map((chapter) => (
				<li value={chapter.data.chapter}>
					<a href={`/novels/${novel.id}/${chapterSlug(chapter.id)}/`}>{chapter.data.title}</a>
				</li>
			))
		}
	</ol>
</ReadingLayout>
